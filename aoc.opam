opam-version: "2.0"
depends: [
  "ocaml" {>= "5.0"}
  "dune" {>= "3.7"}
  "base"
  "stdio"
  "ppx_jane"
  "ocaml-lsp-server" {with-dev-setup}
  "ocamlformat" {with-dev-setup}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
